# frontend/.env 로 복사해서 채운다. 앱에 들어가는 값이라 모두 공개돼도 되는 값만 둔다(service_role 키 금지).
EXPO_PUBLIC_SUPABASE_URL=https://<프로젝트>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=        # Supabase > Project Settings > API Keys > Publishable key (또는 anon key)
EXPO_PUBLIC_API_URL=http://<Mac IP>:8000      # 폰에서 접속할 FastAPI 주소. 127.0.0.1은 폰 자신이라 안 됨
