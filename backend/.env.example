# backend/.env 로 복사해서 채운다. 이 파일(.env.example)에는 실제 값을 쓰지 않는다. .env는 커밋 금지.
AUTH_MODE=jwt                      # 개발 중에는 dev
ROS_MODE=mock                      # mock | gateway | rclpy
GATEWAY_TOKEN=                     # ROS_MODE=gateway일 때 관제 게이트웨이와 나눠 쓰는 비밀값(길고 무작위로). 채팅에 붙여 넣지 말 것
PUSH_MODE=mock                     # mock | expo (expo는 실제 푸시 전송)
SUPABASE_URL=                      # https://<프로젝트>.supabase.co  (새 프로젝트는 이 값만 있으면 로그인 토큰을 공개키로 검증한다)
SUPABASE_SERVICE_ROLE_KEY=         # 회원 탈퇴 시 계정 삭제용. 서버에만 두고 앱·채팅에는 절대 넣지 말 것
SUPABASE_JWT_SECRET=               # 예전 방식(공유 비밀) 프로젝트일 때만. SUPABASE_URL이 있으면 쓰지 않는다
# (예전 방식 비밀값 위치: Supabase > Project Settings > API > JWT Secret)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres   # Supabase > Database > Connection string
# 비워 두면 메모리 SQLite(개발용). Supabase 연결 문자열은 비밀번호가 들어 있으니 채팅에 붙여 넣지 말 것
CORS_ORIGINS=                     # 관리자 웹 출처(쉼표 구분), 예: https://admin.example.com
CHARGE_UNIT_PRICE_WON=300         # 충전 단가(원/kWh). 충전 금액 = 충전량 × 단가, 세션 시작 시점 단가로 고정
AUTO_ASSIGN_ROS_IDS=EV-01,EV-02,EV-03  # 차량 등록 시 비어 있는 관제 차량 ID를 자동 배정. 비우면 관리자가 수동 배정
